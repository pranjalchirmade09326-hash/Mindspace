erDiagram
    %% MindSpace peer support and member wellbeing conceptual schema.
    %% Backend implementation: Python (FastAPI / SQLAlchemy Async) in backend/mindspace-fastapi
    %% Clinical care, EMR, licensed-provider workflows, and FHIR are out of scope.
    APP_PRINCIPALS {
        TEXT user_id PK
        TEXT account_state
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deactivated_at
    }
    ROLE_ASSIGNMENTS {
        UUID id PK
        TEXT user_id FK
        TEXT role_code
        TEXT assignment_state
        TEXT granted_by_user_id FK
        TIMESTAMPTZ granted_at
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ revoked_at
        TEXT decision_reason
    }
    MEMBER_PROFILES {
        TEXT user_id PK
        TEXT display_name
        DATE birth_date
        TEXT eligibility_region
        TEXT eligibility_state
        TEXT profile_state
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    MEMBER_PREFERENCES {
        TEXT user_id PK
        TEXT locale
        TEXT timezone
        TEXT[] preferred_languages
        JSONB accessibility
        JSONB communication
        JSONB support_preferences
        TIMESTAMPTZ updated_at
    }
    CONSENT_RECORDS {
        UUID id PK
        TEXT user_id FK
        TEXT purpose_code
        TEXT recipient_user_id FK
        TEXT recipient_scope
        JSONB data_scope
        TEXT policy_version
        TEXT consent_state
        TEXT captured_by
        TIMESTAMPTZ captured_at
        TIMESTAMPTZ expires_at
        UUID supersedes_id FK
    }
    PRIVACY_REQUESTS {
        UUID id PK
        TEXT user_id FK
        TEXT request_type
        TEXT request_state
        TEXT verification_state
        TIMESTAMPTZ requested_at
        TIMESTAMPTZ due_at
        TIMESTAMPTZ completed_at
        TEXT resolution_code
        TEXT operator_user_id FK
    }
    INTAKE_SESSIONS {
        UUID id PK
        TEXT member_id FK
        TEXT channel
        TEXT status
        TEXT locale
        UUID consent_id FK
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        TIMESTAMPTZ last_resumed_at
        TEXT agent_version
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    INTAKE_RESPONSES {
        UUID id PK
        UUID intake_id FK
        INTEGER sequence_no
        TEXT topic_code
        TEXT response_state
        TEXT source_type
        BYTEA content_ciphertext
        TEXT key_version
        JSONB structured_value
        TIMESTAMPTZ created_at
        UUID supersedes_id FK
    }
    WELLBEING_SUMMARIES {
        UUID id PK
        UUID intake_id FK
        TEXT member_id FK
        INTEGER version_no
        BYTEA summary_ciphertext
        TEXT key_version
        TEXT generated_by
        TEXT agent_version
        TEXT review_state
        TIMESTAMPTZ reviewed_at
        TIMESTAMPTZ created_at
    }
    SUPPORT_RECOMMENDATIONS {
        UUID id PK
        UUID intake_id FK
        TEXT member_id FK
        TEXT support_level
        TEXT option_code
        TEXT availability_state
        BYTEA rationale_ciphertext
        TIMESTAMPTZ selected_at
        TIMESTAMPTZ created_at
    }
    WELLBEING_SESSIONS {
        UUID id PK
        TEXT member_id FK
        TEXT session_type
        TEXT status
        TEXT locale
        UUID consent_id FK
        TEXT agent_version
        TIMESTAMPTZ started_at
        TIMESTAMPTZ ended_at
    }
    WELLBEING_MESSAGES {
        UUID id PK
        UUID session_id FK
        INTEGER sequence_no
        TEXT speaker_type
        BYTEA content_ciphertext
        TEXT key_version
        TEXT delivery_state
        TIMESTAMPTZ created_at
        TIMESTAMPTZ deleted_at
    }
    JOURNAL_ENTRIES {
        UUID id PK
        TEXT member_id FK
        BYTEA title_ciphertext
        BYTEA body_ciphertext
        TEXT key_version
        TEXT visibility
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ deleted_at
    }
    SELF_HELP_CONTENT {
        UUID id PK
        TEXT content_code UK
        TEXT content_type
        TEXT title
        TEXT locale
        INTEGER content_version
        JSONB body
        TEXT review_state
        TEXT author_user_id FK
        TEXT reviewer_user_id FK
        TIMESTAMPTZ effective_from
        TIMESTAMPTZ effective_to
        TIMESTAMPTZ created_at
    }
    EXERCISE_SESSIONS {
        UUID id PK
        UUID content_id FK
        TEXT member_id FK
        INTEGER content_version
        TEXT progress_state
        BYTEA reflection_ciphertext
        TEXT key_version
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
    }
    WELLBEING_GOALS {
        UUID id PK
        TEXT member_id FK
        BYTEA goal_ciphertext
        TEXT key_version
        TEXT source_type
        TEXT status
        DATE target_date
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
        TIMESTAMPTZ closed_at
    }
    GOAL_CHECKINS {
        UUID id PK
        UUID goal_id FK
        TEXT member_id FK
        TEXT checkin_state
        BYTEA note_ciphertext
        TIMESTAMPTZ reported_at
    }
    LISTENER_PROFILES {
        UUID id PK
        TEXT user_id UK
        TEXT application_state
        TEXT eligibility_state
        TIMESTAMPTZ approved_at
        TIMESTAMPTZ eligibility_expires_at
        SMALLINT capacity_limit
        TEXT[] profile_languages
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    LISTENER_TRAINING_RECORDS {
        UUID id PK
        UUID listener_id FK
        TEXT module_code
        TEXT module_version
        TEXT completion_state
        TIMESTAMPTZ completed_at
        TIMESTAMPTZ expires_at
        TEXT reviewed_by_user_id FK
    }
    LISTENER_AVAILABILITY {
        UUID id PK
        UUID listener_id FK
        TIMESTAMPTZ starts_at
        TIMESTAMPTZ ends_at
        TEXT availability_state
        TEXT timezone
        TIMESTAMPTZ created_at
    }
    LISTENER_MATCH_REQUESTS {
        UUID id PK
        TEXT member_id FK
        TEXT request_state
        TEXT[] preferred_languages
        JSONB preferences
        UUID shared_summary_id FK
        UUID consent_id FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ closed_at
    }
    LISTENER_MATCHES {
        UUID id PK
        UUID request_id FK
        UUID listener_id FK
        TEXT match_state
        TIMESTAMPTZ offered_at
        TIMESTAMPTZ accepted_at
        TIMESTAMPTZ ended_at
        TEXT end_reason_code
        JSONB match_rationale
    }
    PEER_CONVERSATIONS {
        UUID id PK
        UUID match_id UK
        TEXT member_id FK
        UUID listener_id FK
        TEXT channel
        TEXT conversation_state
        TIMESTAMPTZ started_at
        TIMESTAMPTZ ended_at
        TEXT closed_by_user_id FK
    }
    PEER_MESSAGES {
        UUID id PK
        UUID conversation_id FK
        BIGINT sequence_no
        TEXT sender_user_id FK
        BYTEA content_ciphertext
        TEXT key_version
        TEXT delivery_state
        TIMESTAMPTZ sent_at
        TIMESTAMPTZ delivered_at
    }
    CONDUCT_REPORTS {
        UUID id PK
        UUID conversation_id FK
        TEXT reporter_user_id FK
        TEXT reported_user_id FK
        TEXT category_code
        BYTEA details_ciphertext
        TEXT report_state
        TEXT assigned_to_user_id FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ resolved_at
    }
    SAFETY_CASES {
        UUID id PK
        TEXT member_id FK
        TEXT source_type
        UUID source_record_id
        TEXT trigger_code
        TEXT policy_version
        TEXT case_state
        TEXT priority_code
        TEXT jurisdiction
        TEXT assigned_responder_user_id FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ acknowledged_at
        TIMESTAMPTZ closed_at
        TEXT resolution_code
    }
    SAFETY_CASE_ACTIONS {
        UUID id PK
        UUID case_id FK
        TEXT actor_user_id FK
        TEXT action_type
        TEXT action_state
        UUID resource_id FK
        BYTEA details_ciphertext
        TEXT key_version
        TIMESTAMPTZ occurred_at
    }
    CRISIS_RESOURCES {
        UUID id PK
        TEXT region_code
        TEXT locale
        TEXT resource_type
        TEXT display_name
        JSONB contact_details
        TEXT source_url
        TEXT verification_state
        TEXT verified_by_user_id FK
        TIMESTAMPTZ last_verified_at
        TIMESTAMPTZ effective_from
        TIMESTAMPTZ effective_to
    }
    FOLLOWUPS {
        UUID id PK
        TEXT member_id FK
        TEXT source_type
        UUID source_record_id
        TIMESTAMPTZ scheduled_at
        TEXT followup_state
        BYTEA response_ciphertext
        TEXT key_version
        TIMESTAMPTZ created_at
        TIMESTAMPTZ completed_at
    }
    NOTIFICATIONS {
        UUID id PK
        TEXT user_id FK
        TEXT notification_type
        TEXT channel
        TEXT payload_reference
        TIMESTAMPTZ scheduled_at
        TIMESTAMPTZ sent_at
        TEXT delivery_state
        SMALLINT attempt_count
        TEXT deduplication_key UK
        TIMESTAMPTZ created_at
    }
    AI_PROCESSING_RUNS {
        UUID id PK
        TEXT member_id FK
        TEXT purpose_code
        TEXT source_type
        UUID source_record_id
        UUID consent_id FK
        TEXT model_version
        TEXT policy_version
        TEXT run_state
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        TEXT error_code
    }
    AUDIT_EVENTS {
        UUID id PK
        TEXT actor_user_id FK
        TEXT actor_type
        TEXT action_code
        TEXT resource_type
        TEXT resource_id
        TEXT purpose_code
        TEXT outcome
        UUID correlation_id
        TIMESTAMPTZ occurred_at
        JSONB metadata
    }
    MOOD_ENTRIES {
        UUID id PK
        TEXT member_id FK
        TEXT mood_code
        TEXT scale_code
        NUMERIC scale_value
        BYTEA note_ciphertext
        TEXT key_version
        TEXT source_type
        TIMESTAMPTZ recorded_at
        TIMESTAMPTZ created_at
    }
    WELLBEING_REFLECTIONS {
        UUID id PK
        TEXT member_id FK
        TEXT reflection_type
        TEXT prompt_version
        TEXT locale
        TEXT status
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        TEXT source_type
    }
    WELLBEING_ACTIVITIES {
        UUID id PK
        TEXT member_id FK
        UUID content_id FK
        INTEGER content_version
        TEXT status
        BYTEA reflection_ciphertext
        TEXT key_version
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
    }
    LISTENER_SUPERVISOR_ASSIGNMENTS {
        UUID id PK
        UUID listener_id FK
        TEXT supervisor_user_id FK
        TEXT assignment_state
        TEXT assigned_by_user_id FK
        TIMESTAMPTZ assigned_at
        TIMESTAMPTZ ended_at
        TEXT reason_code
    }
    LISTENER_FEEDBACK {
        UUID id PK
        UUID conversation_id FK
        TEXT member_id FK
        SMALLINT rating
        BYTEA feedback_ciphertext
        TEXT key_version
        TEXT review_state
        TIMESTAMPTZ submitted_at
        TEXT reviewed_by_user_id FK
    }
    WORKFLOW_DEFINITIONS {
        UUID id PK
        TEXT process_code UK
        TEXT version
        TEXT status
        TEXT policy_version
        TIMESTAMPTZ created_at
    }
    WORKFLOW_EXECUTIONS {
        UUID id PK
        UUID definition_id FK
        TEXT temporal_workflow_id UK
        TEXT subject_type
        TEXT subject_id
        TEXT status
        TIMESTAMPTZ started_at
        TIMESTAMPTZ closed_at
        UUID correlation_id
    }
    WORKFLOW_STEPS {
        UUID id PK
        UUID execution_id FK
        TEXT step_code
        INTEGER attempt_no
        TEXT status
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        TEXT failure_code
    }
    WORKFLOW_TASKS {
        UUID id PK
        UUID execution_id FK
        TEXT task_code
        TEXT assignee_user_id FK
        TEXT required_role
        TEXT status
        TIMESTAMPTZ due_at
        TIMESTAMPTZ completed_at
        TEXT reason_code
    }
    WORKFLOW_TIMERS {
        UUID id PK
        UUID execution_id FK
        TEXT timer_code
        TIMESTAMPTZ due_at
        TEXT status
        TIMESTAMPTZ fired_at
        TEXT policy_version
    }
    WORKFLOW_EVENTS {
        UUID id PK
        UUID execution_id FK
        TEXT event_code
        INTEGER event_version
        TIMESTAMPTZ occurred_at
        TEXT actor_type
        TEXT actor_id
        JSONB payload_metadata
    }
    HUMAN_APPROVALS {
        UUID id PK
        UUID execution_id FK
        UUID task_id FK
        TEXT approver_user_id FK
        TEXT required_role
        TEXT decision
        TEXT decision_reason_code
        TIMESTAMPTZ decided_at
        TEXT policy_version
    }
    WORKFLOW_COMPENSATIONS {
        UUID id PK
        UUID execution_id FK
        UUID step_id FK
        TEXT compensation_code
        TEXT status
        TEXT idempotency_key UK
        TIMESTAMPTZ completed_at
        TEXT failure_code
    }
    AGENT_TOOL_INVOCATIONS {
        UUID id PK
        UUID agent_run_id FK
        TEXT tool_code
        TEXT tool_version
        TEXT[] scope
        BYTEA input_digest
        BYTEA output_digest
        TEXT status
        TIMESTAMPTZ started_at
        TIMESTAMPTZ completed_at
        UUID correlation_id
    }
    OUTBOX_EVENTS {
        UUID id PK
        TEXT aggregate_type
        TEXT aggregate_id
        TEXT event_type
        INTEGER event_version
        JSONB payload
        TIMESTAMPTZ created_at
        TIMESTAMPTZ published_at
        INTEGER attempt_count
        TIMESTAMPTZ next_attempt_at
        UUID correlation_id
    }
    EVENT_CONSUMER_RECEIPTS {
        TEXT consumer_id PK
        UUID event_id PK
        TEXT idempotency_key
        TEXT status
        TIMESTAMPTZ processed_at
        TEXT failure_code
    }
