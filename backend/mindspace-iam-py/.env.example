NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# IAM tables live in the "iam" schema of the shared MindSpace PostgreSQL cluster.
DATABASE_URL=postgresql://mindspace:dev-only-change-me@localhost:5433/mindspace?schema=iam

BETTER_AUTH_URL=http://localhost:5001
# 32+ characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-replace-with-a-generated-32-byte-secret

JWT_ISSUER=http://localhost:5001
JWT_AUDIENCE=mindspace-api

TRUSTED_ORIGINS=http://localhost:4000

# Development seed only.
MINDSPACE_API_DATABASE_URL=postgresql://mindspace:dev-only-change-me@localhost:5433/mindspace
SEED_MINDSPACE_API=true
