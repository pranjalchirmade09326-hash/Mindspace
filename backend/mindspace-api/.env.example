NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Local MindSpace-only PostgreSQL. Never point this at a legacy/FHIR database.
DATABASE_URL=postgresql://mindspace:dev-only-change-me@localhost:5433/mindspace?schema=public
POSTGRES_DB=mindspace
POSTGRES_USER=mindspace
POSTGRES_PASSWORD=dev-only-change-me

# MindSpace-owned identity provider (OIDC issuer and JWKS URL).
AUTH_ISSUER=http://localhost:5001
AUTH_AUDIENCE=mindspace-api
AUTH_JWKS_URL=http://localhost:5001/api/auth/jwks

CORS_ORIGINS=http://localhost:4000

# Replace these with generated 32-byte keys before starting the API.
# JSON object maps key version to base64-encoded 32-byte AES key.
INTAKE_ENCRYPTION_KEYS_JSON={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
INTAKE_CURRENT_ENCRYPTION_KEY_VERSION=v1

# Optional OpenAI-compatible transcription endpoint.
# Voice transcription returns 503 until configured with an approved provider.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
