NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# MindSpace-owned PostgreSQL. The IAM tables live in the "iam" schema of the
# same local cluster the MindSpace API uses, in line with the architecture
# guidance to share the cluster while keeping domain schemas separate.
DATABASE_URL=postgresql://mindspace:dev-only-change-me@localhost:5433/mindspace?schema=iam

# The public URL of this identity service. Must match the frontend's
# NEXT_PUBLIC_BETTER_AUTH_URL and the API's AUTH_ISSUER.
BETTER_AUTH_URL=http://localhost:5001

# 32+ character secret used to encrypt sessions and JWKS private keys.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-replace-with-a-generated-32-byte-secret

# JWT contract consumed by backend/mindspace-api.
JWT_ISSUER=http://localhost:5001
JWT_AUDIENCE=mindspace-api

# Browser origins allowed to call the auth endpoints (cookie credentials).
TRUSTED_ORIGINS=http://localhost:4000

# Development seed only. Points at the MindSpace API schema (public) so the
# seeded demo identities also receive app_principals and role assignments.
MINDSPACE_API_DATABASE_URL=postgresql://mindspace:dev-only-change-me@localhost:5433/mindspace
SEED_MINDSPACE_API=true
