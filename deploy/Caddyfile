{$APP_DOMAIN} {
	encode zstd gzip

	# Identity (Better Auth) lives under /api/auth on the same host so the
	# session cookie is shared with the Next.js app.
	handle /api/auth/* {
		reverse_proxy iam:5001
	}

	handle /api/v1/* {
		reverse_proxy api:8080
	}

	handle /api-docs* {
		reverse_proxy api:8080
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
